{
  "name": "@blamnetwork/datamine",
  "version": "1.1.0",
  "description": "Bungie-style event logs and datamine files for TypeScript, ported from cseries",
  "type": "module",
  "files": [
    "dist",
    "dist-cjs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "validate": "npm run check && npm run typecheck && npm run build && npm run test",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blam-Network/datamine.git"
  },
  "bugs": {
    "url": "https://github.com/Blam-Network/datamine/issues"
  },
  "homepage": "https://github.com/Blam-Network/datamine#readme",
  "keywords": [
    "destiny",
    "halo",
    "blam",
    "datamine",
    "events"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/events.d.ts",
          "default": "./dist/events.js"
        },
        "require": {
          "types": "./dist-cjs/events.d.ts",
          "default": "./dist-cjs/events.js"
        },
        "default": "./dist/events.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      },
      "default": "./dist/index.js"
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist-cjs/events.d.ts",
        "default": "./dist-cjs/events.js"
      },
      "default": "./dist/events.js"
    },
    "./reading": {
      "import": {
        "types": "./dist/reading/index.d.ts",
        "default": "./dist/reading/index.js"
      },
      "require": {
        "types": "./dist-cjs/reading/index.d.ts",
        "default": "./dist-cjs/reading/index.js"
      },
      "default": "./dist/reading/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "events": [
        "./dist/events.d.ts"
      ],
      "reading": [
        "./dist/reading/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@craftycodie/cstruct": "^2.0.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22",
    "typescript": "^5",
    "ultracite": "7.7.0",
    "vitest": "^3.2.4"
  }
}
